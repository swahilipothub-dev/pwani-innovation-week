  },
  "components": {
    "schemas": {
      "ScheduleSpeaker": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": ["string", "null"] },
          "title": { "type": ["string", "null"] },
          "speakerType": {
            "type": ["string", "null"],
            "enum": ["Keynote Speaker", "Guest Speaker", "Regular", null]
          },
          "organization": { "type": ["string", "null"] }
        }
      },
      "ScheduleTrack": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "_id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] }
        },
        "required": ["id", "_id", "name"]
      },
      "ScheduleItem": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "id": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] },
          "session_rsvp_link": { "type": ["string", "null"], "format": "uri" },
          "day": { "type": ["integer", "null"] },
          "date": { "type": ["string", "null"], "format": "date-time" },
          "start_time": { "type": ["string", "null"] },
          "end_time": { "type": ["string", "null"] },
          "moderator": { "type": ["string", "null"] },
          "venue": { "type": ["string", "null"] },
          "type": { "type": ["string", "null"] },
          "speakers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ScheduleSpeaker" }
          },
          "track": {
            "oneOf": [
              { "$ref": "#/components/schemas/ScheduleTrack" },
              { "type": "null" }
            ]
          },
          "createdAt": { "type": ["string", "null"], "format": "date-time" },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": ["_id", "id", "title", "start_time", "end_time", "speakers"]
      }
    }
  }
}
