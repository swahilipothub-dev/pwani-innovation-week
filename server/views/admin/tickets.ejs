<div class="container py-3">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Ticket Types</h2>
    <a href="/admin" class="btn btn-outline-secondary">Back to Dashboard</a>
  </div>

  <div class="card mb-4">
    <div class="card-header">Add Ticket Type</div>
    <div class="card-body">
      <form method="POST" action="/admin/tickets" class="row g-3">
        <div class="col-md-4">
          <label class="form-label" for="ticket-name">Name</label>
          <input type="text" class="form-control" id="ticket-name" name="name" placeholder="Early Bird" required>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="ticket-amount">Amount</label>
          <input type="number" class="form-control" id="ticket-amount" name="amount" min="0" step="0.01" placeholder="0.00" required>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="ticket-link">Payment Link</label>
          <input type="url" class="form-control" id="ticket-link" name="payment_link" placeholder="https://payment.provider/checkout">
        </div>
        <div class="col-12">
          <label class="form-label" for="ticket-description">Description</label>
          <textarea class="form-control" id="ticket-description" name="description" rows="2" placeholder="Details about this ticket tier"></textarea>
        </div>
        <div class="col-12 text-end">
          <button type="submit" class="btn btn-primary">Create Ticket Type</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-semibold">Existing Ticket Types</span>
      <span class="badge text-bg-secondary"><%= tickets.length %> total</span>
    </div>
    <div class="table-responsive">
      <table class="table table-striped mb-0">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Amount</th>
            <th>Description</th>
            <th>Payment Link</th>
            <th>Updated</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!tickets.length) { %>
            <tr>
              <td colspan="6" class="text-center text-muted py-4">No ticket types have been created yet.</td>
            </tr>
          <% } %>
          <% tickets.forEach(ticket => { %>
            <tr>
              <td><strong><%= ticket.name %></strong></td>
              <td>
                <span class="badge text-bg-primary">
                  <%= ticket.amount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </span>
              </td>
              <td style="max-width: 320px;">
                <% if (ticket.description) { %>
                  <%= ticket.description %>
                <% } else { %>
                  <span class="text-muted">No description</span>
                <% } %>
              </td>
              <td>
                <% if (ticket.payment_link) { %>
                  <a href="<%= ticket.payment_link %>" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">Open Link</a>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td><%= new Date(ticket.updatedAt).toLocaleString() %></td>
              <td class="text-end">
                <div class="btn-group" role="group">
                  <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editTicket-<%= ticket._id %>">Edit</button>
                  <form method="POST" action="/admin/tickets/<%= ticket._id %>?_method=DELETE" onsubmit="return confirm('Delete this ticket type?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                  </form>
                </div>
              </td>
            </tr>

            <div class="modal fade" id="editTicket-<%= ticket._id %>" tabindex="-1" aria-labelledby="editTicketLabel-<%= ticket._id %>" aria-hidden="true">
              <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                  <form method="POST" action="/admin/tickets/edit/<%= ticket._id %>">
                    <div class="modal-header">
                      <h5 class="modal-title" id="editTicketLabel-<%= ticket._id %>">Edit Ticket Type</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" name="name" value="<%= ticket.name %>" required>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Amount</label>
                        <input type="number" class="form-control" name="amount" min="0" step="0.01" value="<%= ticket.amount %>" required>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Payment Link</label>
                        <input type="url" class="form-control" name="payment_link" value="<%= ticket.payment_link || '' %>">
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" name="description" rows="3"><%= ticket.description || '' %></textarea>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                      <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
