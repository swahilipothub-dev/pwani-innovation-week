<div class="container py-3">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Mentees</h2>
    <a href="/admin" class="btn btn-outline-secondary">Back to Dashboard</a>
  </div>

  <div class="d-flex flex-wrap gap-2 mb-3">
    <a href="/admin/attendees/mentees/export/csv" class="btn btn-outline-primary">Export CSV</a>
    <a href="/admin/attendees/mentees/export/pdf" class="btn btn-outline-primary">Export PDF</a>
    <form class="d-flex gap-2" method="POST" action="/admin/attendees/mentees/import" enctype="multipart/form-data">
      <input type="file" name="file" accept=".csv" class="form-control" required>
      <button type="submit" class="btn btn-outline-secondary">Import CSV</button>
    </form>
  </div>

  <div class="card mb-4">
    <div class="card-header">Add Mentee</div>
    <div class="card-body">
      <form method="POST" action="/admin/attendees/mentees" class="row g-3">
        <div class="col-md-4">
          <label class="form-label">First Name</label>
          <input type="text" name="first_name" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Middle Name</label>
          <input type="text" name="middle_name" class="form-control">
        </div>
        <div class="col-md-4">
          <label class="form-label">Last Name</label>
          <input type="text" name="last_name" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Phone Number</label>
          <input type="text" name="phone_number" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Gender</label>
          <select name="gender" class="form-select" required>
            <option value="" disabled selected>Select gender</option>
            <% genderOptions.forEach(option => { %>
              <option value="<%= option.value %>"><%= option.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Subcounty</label>
          <select name="subcounty" class="form-select" required>
            <option value="" disabled selected>Select subcounty</option>
            <% subcountyOptions.forEach(option => { %>
              <option value="<%= option.value %>"><%= option.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Mentor</label>
          <select name="mentor" class="form-select" required>
            <option value="" disabled selected>Select mentor</option>
            <% mentorOptions.forEach(option => { %>
              <option value="<%= option.value %>"><%= option.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Cohort</label>
          <select name="cohort" class="form-select" required>
            <option value="" disabled selected>Select cohort</option>
            <% cohortOptions.forEach(option => { %>
              <option value="<%= option.value %>"><%= option.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-12 text-end">
          <button type="submit" class="btn btn-primary">Add Mentee</button>
        </div>
      </form>
    </div>
  </div>

  <% const subcountyMap = subcountyLabels || {}; %>
  <% const genderMap = genderLabels || {}; %>
  <% const mentorMap = mentorLabels || {}; %>
  <% const cohortMap = cohortLabels || {}; %>
  <% const totalCount = pagination ? pagination.total : attendees.length; %>
  <% const showingStart = pagination ? pagination.start : (attendees.length ? 1 : 0); %>
  <% const showingEnd = pagination ? pagination.end : attendees.length; %>
  <% const searchValue = (searchTerm || '').trim(); %>
  <% const buildPageLink = (page) => {
       const params = new URLSearchParams();
       params.set('page', page);
       if (searchValue) params.set('search', searchValue);
       return `?${params.toString()}`;
     }; %>

  <div class="card">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-2">
        <span class="fw-semibold">Mentee List</span>
        <span class="badge text-bg-secondary"><%= totalCount %> total</span>
      </div>
      <form method="GET" class="d-flex gap-2 flex-wrap" action="">
        <input
          type="text"
          name="search"
          value="<%= searchValue %>"
          class="form-control form-control-sm"
          placeholder="Search by name, email, mentor..."
        >
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
        <% if (searchValue) { %>
          <a href="?" class="btn btn-sm btn-outline-light border">Clear</a>
        <% } %>
      </form>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Name</th>
              <th>Phone</th>
              <th>Email</th>
              <th>Cohort</th>
              <th>Code</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!attendees.length) { %>
              <tr>
                <td colspan="6" class="text-center text-muted py-4">
                  <% if (searchValue) { %>
                    No mentees match your search.
                  <% } else { %>
                    No mentees recorded yet.
                  <% } %>
                </td>
              </tr>
            <% } %>
            <% attendees.forEach(item => { %>
              <% const fullName = [item.first_name, item.middle_name, item.last_name].filter(Boolean).join(' '); %>
              <tr>
                <td class="text-break"><strong><%= fullName %></strong></td>
                <td class="text-break"><%= item.phone_number %></td>
                <td class="text-break"><%= item.email %></td>
                <td class="text-break"><%= cohortMap[item.cohort] || item.cohort %></td>
                <td><span class="badge text-bg-primary"><%= item.code %></span></td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#viewMentee-<%= item._id %>">View</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editMentee-<%= item._id %>">Edit</button>
                    <form method="POST" action="/admin/attendees/mentees/<%= item._id %>?_method=DELETE" onsubmit="return confirm('Delete this record?');">
                      <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% if (pagination) { %>
      <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="text-muted small mb-0">
          <% if (pagination.total === 0) { %>
            No mentees to display.
          <% } else { %>
            Showing <%= showingStart %>-<%= showingEnd %> of <%= totalCount %>
          <% } %>
        </div>
        <% if (pagination.totalPages > 1) { %>
          <nav>
            <ul class="pagination pagination-sm mb-0 flex-wrap gap-1">
              <li class="page-item <%= pagination.hasPrev ? '' : 'disabled' %>">
                <a class="page-link" href="<%= pagination.hasPrev ? buildPageLink(pagination.prevPage) : '#' %>">Prev</a>
              </li>
              <% pagination.visiblePages.forEach(pageItem => { %>
                <% if (pageItem.type === 'ellipsis') { %>
                  <li class="page-item disabled">
                    <span class="page-link">...</span>
                  </li>
                <% } else { %>
                  <li class="page-item <%= pageItem.number === pagination.page ? 'active' : '' %>">
                    <a class="page-link" href="<%= buildPageLink(pageItem.number) %>"><%= pageItem.number %></a>
                  </li>
                <% } %>
              <% }) %>
              <li class="page-item <%= pagination.hasNext ? '' : 'disabled' %>">
                <a class="page-link" href="<%= pagination.hasNext ? buildPageLink(pagination.nextPage) : '#' %>">Next</a>
              </li>
            </ul>
          </nav>
        <% } %>
      </div>
    <% } %>
  </div>

  <% attendees.forEach(item => { %>
    <% const fullName = [item.first_name, item.middle_name, item.last_name].filter(Boolean).join(' '); %>
    <div class="modal fade" id="viewMentee-<%= item._id %>" tabindex="-1" aria-labelledby="viewMenteeLabel-<%= item._id %>" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="viewMenteeLabel-<%= item._id %>">Mentee Details</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="row g-3">
              <div class="col-md-6">
                <h6 class="text-uppercase text-muted small mb-1">Name</h6>
                <p class="mb-0 fw-semibold text-break"><%= fullName %></p>
              </div>
              <div class="col-md-6">
                <h6 class="text-uppercase text-muted small mb-1">Code</h6>
                <p class="mb-0"><span class="badge text-bg-primary"><%= item.code %></span></p>
              </div>
              <div class="col-md-6">
                <h6 class="text-uppercase text-muted small mb-1">Email</h6>
                <p class="mb-0 text-break"><%= item.email %></p>
              </div>
              <div class="col-md-6">
                <h6 class="text-uppercase text-muted small mb-1">Phone</h6>
                <p class="mb-0 text-break"><%= item.phone_number %></p>
              </div>
              <div class="col-md-6">
                <h6 class="text-uppercase text-muted small mb-1">Gender</h6>
                <p class="mb-0"><%= genderMap[item.gender] || item.gender %></p>
              </div>
              <div class="col-md-6">
                <h6 class="text-uppercase text-muted small mb-1">Subcounty</h6>
                <p class="mb-0 text-break"><%= subcountyMap[item.subcounty] || item.subcounty %></p>
              </div>
              <div class="col-md-6">
                <h6 class="text-uppercase text-muted small mb-1">Mentor</h6>
                <p class="mb-0 text-break"><%= mentorMap[item.mentor] || item.mentor %></p>
              </div>
              <div class="col-md-6">
                <h6 class="text-uppercase text-muted small mb-1">Cohort</h6>
                <p class="mb-0 text-break"><%= cohortMap[item.cohort] || item.cohort %></p>
              </div>
              <div class="col-md-6">
                <h6 class="text-uppercase text-muted small mb-1">Created</h6>
                <p class="mb-0 text-break"><%= new Date(item.createdAt).toLocaleString() %></p>
              </div>
              <div class="col-md-6">
                <h6 class="text-uppercase text-muted small mb-1">Last Updated</h6>
                <p class="mb-0 text-break"><%= new Date(item.updatedAt).toLocaleString() %></p>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="editMentee-<%= item._id %>" tabindex="-1" aria-labelledby="editMenteeLabel-<%= item._id %>" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <form method="POST" action="/admin/attendees/mentees/edit/<%= item._id %>">
            <div class="modal-header">
              <h5 class="modal-title" id="editMenteeLabel-<%= item._id %>">Edit Mentee</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label">First Name</label>
                <input type="text" name="first_name" class="form-control" value="<%= item.first_name %>" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Middle Name</label>
                <input type="text" name="middle_name" class="form-control" value="<%= item.middle_name || '' %>">
              </div>
              <div class="mb-3">
                <label class="form-label">Last Name</label>
                <input type="text" name="last_name" class="form-control" value="<%= item.last_name %>" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Phone Number</label>
                <input type="text" name="phone_number" class="form-control" value="<%= item.phone_number %>" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" value="<%= item.email %>" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Gender</label>
                <select name="gender" class="form-select" required>
                  <% genderOptions.forEach(option => { %>
                    <option value="<%= option.value %>" <%= option.value === item.gender ? 'selected' : '' %>><%= option.label %></option>
                  <% }) %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label">Subcounty</label>
                <select name="subcounty" class="form-select" required>
                  <% subcountyOptions.forEach(option => { %>
                    <option value="<%= option.value %>" <%= option.value === item.subcounty ? 'selected' : '' %>><%= option.label %></option>
                  <% }) %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label">Mentor</label>
                <select name="mentor" class="form-select" required>
                  <% mentorOptions.forEach(option => { %>
                    <option value="<%= option.value %>" <%= option.value === item.mentor ? 'selected' : '' %>><%= option.label %></option>
                  <% }) %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label">Cohort</label>
                <select name="cohort" class="form-select" required>
                  <% cohortOptions.forEach(option => { %>
                    <option value="<%= option.value %>" <%= option.value === item.cohort ? 'selected' : '' %>><%= option.label %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% }) %>
</div>
