<!-- views/admin/schedule-create.ejs -->
<% const speakerTypeChoices = typeof speakerTypeOptions !== 'undefined'
     ? speakerTypeOptions
     : ['Keynote Speaker', 'Guest Speaker', 'Regular']; %>

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h1 class="h3 fw-bold mb-1">Create Schedule</h1>
      <p class="text-muted mb-0">Add a new programme item with speakers, timing, and track assignments.</p>
    </div>
    <a href="/admin/schedules" class="btn btn-outline-secondary">
      <i class="fas fa-arrow-left me-2"></i>Back to Schedules
    </a>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-body">
          <form method="POST" action="/admin/schedules">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Title</label>
                <input type="text" name="title" class="form-control" placeholder="e.g. Opening Keynote" required>
              </div>
              <div class="col-md-3">
                <label class="form-label">Day</label>
                <input type="number" name="day" min="1" class="form-control" placeholder="1" required>
              </div>
              <div class="col-md-3">
                <label class="form-label">Date</label>
                <input type="date" name="date" class="form-control" required>
              </div>
            </div>

            <div class="row g-3 mt-1">
              <div class="col-md-6">
                <label class="form-label">Track</label>
                <select name="track" class="form-select" required>
                  <option value="" disabled selected>Select a track</option>
                  <% tracks.forEach(track => { %>
                    <option value="<%= track._id %>"><%= track.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Session Type</label>
                <select name="type" class="form-select">
                  <% ['Session','Panel','Workshop','Opening','Lunch','Closing','Ceremony','Entertainment'].forEach(t => { %>
                    <option value="<%= t %>"><%= t %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="row g-3 mt-1">
              <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                  <label class="form-label mb-0">Speakers</label>
                  <button type="button" class="btn btn-sm btn-outline-primary" id="addScheduleSpeaker">
                    Add Speaker
                  </button>
                </div>
                <div id="scheduleSpeakersList" class="d-flex flex-column gap-3 mt-2">
                  <div class="alert alert-secondary small mb-0" data-speaker-empty>
                    Use "Add Speaker" to include speaker details.
                  </div>
                </div>
                <template id="scheduleSpeakerTemplate">
                  <div class="card border rounded p-3" data-speaker-entry>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <h6 class="mb-0">Speaker <span data-speaker-number></span></h6>
                      <button type="button" class="btn btn-sm btn-outline-danger" data-remove-speaker>&times;</button>
                    </div>
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label">Name</label>
                        <input
                          type="text"
                          class="form-control"
                          name="speakers[__INDEX__][name]"
                          placeholder="Full name"
                          required>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Title / Role</label>
                        <input
                          type="text"
                          class="form-control"
                          name="speakers[__INDEX__][title]"
                          placeholder="e.g. Program Lead">
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Speaker Type</label>
                        <select
                          name="speakers[__INDEX__][speakerType]"
                          class="form-select">
                          <option value="">Select speaker type</option>
                          <% speakerTypeChoices.forEach(type => { %>
                            <option
                              value="<%= type %>"
                              <%= type === speakerTypeChoices[speakerTypeChoices.length - 1] ? 'selected' : '' %>>
                              <%= type %>
                            </option>
                          <% }) %>
                        </select>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Organization / Company</label>
                        <input
                          type="text"
                          class="form-control"
                          name="speakers[__INDEX__][organization]"
                          placeholder="e.g. Pwani Innovation Hub">
                      </div>
                    </div>
                  </div>
                </template>
              </div>
              <div class="col-md-6">
                <label class="form-label">Moderator</label>
                <input type="text" name="moderator" class="form-control" placeholder="Optional">
              </div>
              <div class="col-md-6">
                <label class="form-label">Session RSVP Link <span class="text-muted small">(optional)</span></label>
                <input
                  type="url"
                  name="session_rsvp_link"
                  class="form-control"
                  placeholder="https://example.com/rsvp">
              </div>
            </div>

            <div class="mb-3 mt-3">
              <label class="form-label">Venue</label>
              <input type="text" name="venue" class="form-control" placeholder="e.g. Main Auditorium">
            </div>

            <div class="mb-3">
              <label class="form-label">Description</label>
              <textarea name="description" class="form-control" rows="3" placeholder="Optional session overview"></textarea>
            </div>

            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label">Start Time</label>
                <input type="time" name="start_time" class="form-control" required>
              </div>
              <div class="col-md-4">
                <label class="form-label">End Time</label>
                <input type="time" name="end_time" class="form-control" required>
              </div>
            </div>

            <div class="mt-4 d-flex gap-2">
              <button class="btn btn-primary">Create Schedule</button>
              <a href="/admin/schedules" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <h6 class="text-muted text-uppercase small mb-3">Tips</h6>
          <ul class="list-unstyled small text-muted mb-0">
            <li class="mb-2"><strong>Speakers:</strong> Add at least one speaker entry to save the schedule.</li>
            <li class="mb-2"><strong>Time slots:</strong> Ensure start and end times do not overlap with existing sessions.</li>
            <li class="mb-2"><strong>Tracks:</strong> Tracks help group sessions for attendees and filters.</li>
            <li><strong>Descriptions:</strong> Optional but useful for programme highlights and marketing.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const speakersList = document.getElementById('scheduleSpeakersList');
    const addSpeakerButton = document.getElementById('addScheduleSpeaker');
    const template = document.getElementById('scheduleSpeakerTemplate');

    if (!speakersList || !addSpeakerButton || !template) {
      return;
    }

    const getEntries = () => Array.from(speakersList.querySelectorAll('[data-speaker-entry]'));

    const ensureEmptyState = () => {
      const entries = getEntries();
      const existingEmpty = speakersList.querySelector('[data-speaker-empty]');

      if (!entries.length && !existingEmpty) {
        const empty = document.createElement('div');
        empty.className = 'alert alert-secondary small mb-0';
        empty.dataset.speakerEmpty = '';
        empty.textContent = 'Use "Add Speaker" to include speaker details.';
        speakersList.appendChild(empty);
      } else if (entries.length && existingEmpty) {
        existingEmpty.remove();
      }
    };

    const reindexSpeakers = () => {
      getEntries().forEach((entry, index) => {
        entry.querySelectorAll('[name]').forEach((input) => {
          if (!input.name) return;
          if (input.name.includes('__INDEX__')) {
            input.name = input.name.replace(/__INDEX__/g, index);
          } else {
            input.name = input.name.replace(/\[\d+\]/g, `[${index}]`);
          }
        });

        const counter = entry.querySelector('[data-speaker-number]');
        if (counter) {
          counter.textContent = index + 1;
        }
      });

      ensureEmptyState();
    };

    addSpeakerButton.addEventListener('click', () => {
      const fragment = template.content.cloneNode(true);
      speakersList.appendChild(fragment);
      reindexSpeakers();
    });

    speakersList.addEventListener('click', (event) => {
      const target = event.target.closest('[data-remove-speaker]');
      if (!target) {
        return;
      }

      const entry = target.closest('[data-speaker-entry]');
      if (entry) {
        entry.remove();
        reindexSpeakers();
      }
    });

    reindexSpeakers();
  });
</script>
